# Copy this file to backend/.env and fill in your own values.
# backend/.env is ignored by git - never commit real credentials.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=rubble_tracker
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rubble_tracker

# Long random string used to sign login tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Duplicate detection, in meters
RAIO_DUPLICADO_M=6
RAIO_SUSPEITO_M=15
PRECISAO_MAXIMA_M=20
